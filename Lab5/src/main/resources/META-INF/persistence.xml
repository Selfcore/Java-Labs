<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="notebooks">
        <class>Models.Notebook</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="selfcore"/>
            <property name="jakarta.persistence.jdbc.password" value="secretpassword123"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:15080/NotebookDB"/>
        </properties>
    </persistence-unit>
</persistence>
